using DxMessaging.Core.Attributes;
using DxMessaging.Core.Extensions;
using DxMessaging.Unity;

[DxUntargetedMessage]
[DxAutoConstructor]
public readonly partial struct GamePaused
{
    public readonly bool IsPaused;
}

// PauseController announces the fact after owning the state change.
GamePaused gamePaused = new GamePaused(isPaused);
gamePaused.EmitUntargeted();

// PauseOverlay owns this UI registration.
Token.RegisterUntargeted<GamePaused>(OnPauseOverlayChanged);

// MusicDirector owns a separate audio registration.
Token.RegisterUntargeted<GamePaused>(OnMusicPauseChanged);
