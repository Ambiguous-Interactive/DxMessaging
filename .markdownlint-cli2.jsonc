{
  // NOTE: no "fix" here -- `npm run lint:markdown` is check-only. Auto-fix is
  // opt-in via `--fix` (the pre-commit hook and format-on-demand pass it).
  "ignores": [
    // Exclude third-party and generated content
    "**/node_modules/**",
    "**/.git/**",
    "**/Library/**",
    "**/obj/**",
    "**/Temp/**",
    "**/Samples~/**",
    "**/design-system*/**",
    "**/.github/**",
    "**/.venv/**",
    "**/site/**",
    "**/_site/**",
    // Generated by scripts/llm/harness.js (`npm run llm:index`). markdownlint-cli2 reads ONLY this
    // array (it does not support a .markdownlintignore file), so these entries are what keeps the
    // generator and its --check mode convergent: an autofix bot rewriting a generated file would
    // make `npm run llm:check` fail with no way to recover except regenerating.
    ".llm/index.md",
    ".claude/skills/**",
    ".agents/skills/**",
    // Git-ignored local scratch areas
    "progress/**",
    ".artifacts/**",
    "*PLAN.md",
    "pr-description.md*"
  ]
}
