<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match Unity's NUnit ABI for the generated result-writer compatibility tests. -->
    <PackageDownload Include="NUnit" Version="[3.5.0]" />
    <None
      Include="$(NuGetPackageRoot)nunit/3.5.0/lib/net45/nunit.framework.dll"
      Link="NUnit35/nunit.framework.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="../scripts/unity/DxmNUnitResultWriter.cs.txt"
      Link="DxmNUnitResultWriter.cs.txt"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Update="Fixtures/NUnitResultWriterFixture.cs.txt"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Compile Include="../scripts/mcp/DxMcpTestRunner.cs.txt" Link="DxMcpTestRunner.cs" />
    <ProjectReference
      Include="../SourceGenerators/WallstopStudios.DxMessaging.SourceGenerators/WallstopStudios.DxMessaging.SourceGenerators.csproj"
      AdditionalProperties="CopyAnalyzerPayload=false"
    />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
