<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>WallstopStudios.DxMessaging.Tests.Runtime.AttributesOnly</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <AttributesPackageVersion Condition="'$(AttributesPackageVersion)' == ''"
      >0.0.0-local</AttributesPackageVersion>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../.artifacts/nuget</RestoreAdditionalProjectSources>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="../Tests/Runtime/AttributesOnly/StandaloneAttributeRulesTests.cs"
      Link="StandaloneAttributeRulesTests.cs"
    />
    <PackageReference
      Include="WallstopStudios.DxMessaging.Attributes"
      Version="$(AttributesPackageVersion)"
    />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <Target
    Name="RemoveDxGeneratorsForAbsenceControl"
    BeforeTargets="CoreCompile"
    Condition="'$(DisableDxGenerators)' == 'true'"
  >
    <ItemGroup>
      <DxCompilerInputs
        Include="@(Analyzer)"
        Condition="'%(Analyzer.Filename)' == 'WallstopStudios.DxMessaging.Analyzer' Or '%(Analyzer.Filename)' == 'WallstopStudios.DxMessaging.SourceGenerators'"
      />
      <Analyzer Remove="@(DxCompilerInputs)" />
    </ItemGroup>
    <Error
      Condition="'@(DxCompilerInputs->Count())' != '2'"
      Text="The absence control must remove exactly the two packaged DxMessaging compiler inputs."
    />
    <Message Importance="high" Text="Removed DxMessaging compiler inputs: @(DxCompilerInputs)" />
  </Target>
</Project>
